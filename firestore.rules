rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection validation test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Master state snapshot backup (SinoTrack ERP Complete Cloud Persistence)
    match /system/{docId} {
      allow read, write: if isValidId(docId);
    }

    // Suppliers collection
    match /suppliers/{supplierId} {
      allow read, write: if isValidId(supplierId);
    }

    // Products collection
    match /products/{productId} {
      allow read, write: if isValidId(productId);
    }

    // Catalogs collection (links stored with Drive file metadata)
    match /catalogs/{catalogId} {
      allow read, write: if isValidId(catalogId);
    }

    // Purchase orders collection
    match /orders/{orderId} {
      allow read, write: if isValidId(orderId);
    }

    // Invoices collection
    match /invoices/{invoiceId} {
      allow read, write: if isValidId(invoiceId);
    }
  }
}
